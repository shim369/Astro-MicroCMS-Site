---
import { Image } from "astro:assets";
import type { Post } from "../lib/posts";

export interface Props {
  post: Post;
}

const { id, data: a } = Astro.props.post;
---
<article class="blog-card" data-r>
  <a href={`/articles/${id}`}>
    <div class="img-category">
      {a.eyecatch && (
        <Image
          src={a.eyecatch.url}
          alt={a.title}
          width={640}
          height={480}
          fit="cover"
          layout="constrained"
          transition:name={`eyecatch-${id}`}
        />
      )}
      {a.category?.name && <p class="cat">{a.category.name}</p>}
      <span class="go" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 15L15 3M6 3h9v9" stroke="currentColor" stroke-width="2"/></svg></span>
    </div>
    <div class="date">
      <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="6.2" stroke="currentColor"/><path d="M7 3.5V7l2.4 1.6" stroke="currentColor"/></svg>
      {new Intl.DateTimeFormat("en-US", { dateStyle: "medium" }).format(new Date(a.publishedAt))}
    </div>
    <h3><span>{a.title}</span></h3>
  </a>
</article>
