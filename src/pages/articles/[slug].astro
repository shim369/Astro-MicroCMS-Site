---
import Layout from '../../layouts/Layout.astro'
import HeaderDetail from '../../components/HeaderDetail.astro'
import Contact from '../../components/Contact.astro'
import { getArticles } from '../../lib/microcms'
import type { Article } from '../../lib/microcms'
import '../../styles/css/detail.css';

export const getStaticPaths = async () => {
  const articles = await getArticles()
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }))
}

const { article } = Astro.props as { article: Article }
---

<Layout title={`${article.title} | ASTRO BASE`}>
	<HeaderDetail />
	<main class="bg-gray">
	<section>
		<div class="container">
			<div class="blog-detail-area">
				<div class="blog-content">
				<h1>{article.title}</h1>
				<div class="date"><span class="material-icons schedule-icon">schedule</span>{ new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(new Date(article.publishedAt))}</div>
				<article set:html={article.content} />
			</div>
			</div>
		</div>
	</section>
	<Contact />
	</main>
</Layout>